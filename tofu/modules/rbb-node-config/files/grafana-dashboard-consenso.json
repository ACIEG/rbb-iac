{
 "title": "RBB - consenso",
 "uid": "rbb-consenso",
 "tags": [
  "rbb"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Nosso validator",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Validators vistos pelo nosso validator",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rbb:validators_connected",
     "refId": "A",
     "legendFormat": "vistos",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rbb:validators_expected",
     "refId": "B",
     "legendFormat": "no consenso",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "none",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Validators de outras organizações, no consenso QBFT agora, com sessão P2P ativa com o nosso."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Nossa fatia do consenso",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rbb_blocks_proposed_last100{own=\"true\", node=~\"validator.*\"})",
     "refId": "A",
     "legendFormat": "blocos propostos, 100 últimos",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rbb_consensus_validators{node=~\"validator.*\"})",
     "refId": "B",
     "legendFormat": "validators no consenso",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 5
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "validators no consenso"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#6e6e6e"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#6e6e6e",
           "value": null
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "description": "Esperado: cerca de 100 dividido pelo número de validators. Zero por 10 min dispara ValidatorNotProposing."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Último bloco proposto por nós",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rbb_last_proposed_block{own=\"true\", node=~\"validator.*\"})",
     "refId": "A",
     "legendFormat": "bloco",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(ethereum_blockchain_height{job=\"rbb\",node=~\"validator.*\"}) - max(rbb_last_proposed_block{own=\"true\", node=~\"validator.*\"})",
     "refId": "B",
     "legendFormat": "blocos atrás da ponta",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "none",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Com N validators, propomos um bloco a cada N; mais de ~3N blocos sem propor é sinal de problema."
  },
  {
   "id": 5,
   "type": "row",
   "title": "Todos os validators do consenso",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 6,
   "type": "bargauge",
   "title": "Blocos propostos por validator, últimos 100",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (organization, validator) (rbb_blocks_proposed_last100{node=~\"validator.*\"})",
     "refId": "A",
     "legendFormat": "{{organization}} / {{validator}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "showUnfilled": true,
    "valueMode": "color",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "text": {
     "titleSize": 13,
     "valueSize": 16
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 30,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 5
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Lido do nosso validator (qbft_getSignerMetrics). Um validator em zero está parado e tende a ser removido do consenso pelos demais."
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Blocos propostos ao longo do tempo (janela de 100 blocos)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (organization) (rbb_blocks_proposed_last100{node=~\"validator.*\"})",
     "refId": "A",
     "legendFormat": "{{organization}}"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "description": "Quando uma linha cai a zero e fica, aquele validator parou de propor."
  }
 ],
 "templating": {
  "list": []
 },
