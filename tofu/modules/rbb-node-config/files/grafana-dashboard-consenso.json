  {
   "id": 3,
   "type": "stat",
   "title": "Nossa fatia do consenso",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(rbb_blocks_proposed_last100{own=\"true\", node=~\"validator.*\"})",
     "refId": "A",
     "legendFormat": "blocos propostos, 100 últimos",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "round(100 / max(rbb_consensus_validators{node=~\"validator.*\"}))",
     "refId": "B",
     "legendFormat": "esperado (100 / validators)",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value_and_name",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 5
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "esperado (100 / validators)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "text"
        }
       }
      ]
     }
    ]
   },
   "description": "O QBFT reveza os proponentes em ordem fixa: com N validators no consenso, cada um propõe ~100/N blocos a cada 100. Abaixo disso, estamos perdendo vezes; zero por 10 min dispara ValidatorNotProposing."
  },
