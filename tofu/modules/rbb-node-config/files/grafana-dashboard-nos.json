   },
   "panels": [],
   "repeat": "organization"
  },
  {
   "id": 14,
   "type": "stat",
   "title": "Firewall deles aberto para nós",
   "description": "Teste TCP do nosso nó até cada nó deles que está na nossa lista de peers (validators e boots). \"não se aplica\": organização sem validator/boot na nossa lista (ex.: parceiro só com writer e observer-boot, que se conectam a nós por iniciativa deles).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rbb_peer_port_open{organization=\"$organization\", own=\"false\", node=~\"boot.*|validator.*\"}",
     "refId": "A",
     "legendFormat": "{{peer}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true,
    "text": {
     "titleSize": 14,
     "valueSize": 22
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#6e6e6e",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "fechada",
         "color": "red"
        },
        "1": {
         "text": "aberta",
         "color": "green"
        }
       }
      }
     ],
     "noValue": "não se aplica"
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "stat",
   "title": "Sessões P2P com nossos boot e validator",
   "description": "Sessões P2P ativas do nosso boot e do nosso validator com os nós deles (nome do nó deles). validator = consenso (vermelho se faltar); boot/writer = rede, alterna com o tempo (laranja se faltar).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (organization, peer) (rbb_peer_connected{organization=\"$organization\", own=\"false\", node=~\"boot.*|validator.*\"}) or (max by (organization, peer) (rbb_peer_expected{organization=\"$organization\", own=\"false\", node=~\"boot.*|validator.*\"}) * 0)",
     "refId": "A",
     "legendFormat": "{{peer}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true,
    "text": {
     "titleSize": 14,
     "valueSize": 22
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#6e6e6e",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "sem sessão",
         "color": "red"
        },
        "1": {
         "text": "conectado",
         "color": "green"
        }
       }
      }
     ],
     "noValue": "nenhuma"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "/^(boot|writer|observer)/"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "sem sessão (alterna)",
            "color": "orange"
           },
           "1": {
            "text": "conectado",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#6e6e6e",
           "value": null
          },
          {
           "color": "orange",
           "value": 0
          },
          {
           "color": "green",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Federação do Prometheus",
   "description": "Porta 8443 aberta para o nosso Prometheus e NGINX aceitando o nosso certificado.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"federation-port\", organization=\"$organization\"} * 2 + on(instance) group_left(organization) (probe_http_status_code{job=\"federation-tls\", organization=\"$organization\"} == bool 200)",
     "refId": "A",
     "legendFormat": "monitoramento",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true,
    "text": {
     "titleSize": 14,
     "valueSize": 22
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
