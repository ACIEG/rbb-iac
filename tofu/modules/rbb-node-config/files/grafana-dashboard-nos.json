  },
  {
   "id": 2,
   "type": "stat",
   "title": "Saúde",
   "description": "Por papel: validator precisa ver os outros validators; writer/observer-boot/observer precisam do boot próprio; boot precisa de boots parceiros. Também pesa sincronização, reinícios, disco e memória. Motivos nos painéis abaixo.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(rbb:node_health, \"node\", \"obsboot$1\", \"node\", \"observer-boot([0-9]+)\")",
     "refId": "A",
     "legendFormat": "{{node}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value_and_name",
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "wideLayout": true
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "saudável",
         "color": "green"
        },
        "1": {
         "text": "atenção",
         "color": "orange"
        },
        "2": {
         "text": "problema",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
